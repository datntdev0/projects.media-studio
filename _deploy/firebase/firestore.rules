rules_version = '2';

// Nothing reaches Firestore from a browser: the studio talks to the NestJS API,
// which reads and writes through the Admin SDK — and the Admin SDK bypasses
// these rules by design. So the only correct client rule is "no".
//
// Keeping it closed is not belt-and-braces. A rule that allowed a signed-in user
// to read `libraryItems` would hand every account the whole catalogue the moment
// someone lifted the web config out of the bundle, where it is public by design.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
