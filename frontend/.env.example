# Copy to .env and adjust. Every variable is optional — the defaults live in
# `runtimeConfig.public` in nuxt.config.ts, and the values below are what local
# development against the Firebase Auth emulator uses.

# The backend's origin, without the `/api/v1` prefix — that belongs to the paths.
NUXT_PUBLIC_API_BASE=http://localhost:3001

# Point the client SDK at the Auth, Storage and Realtime Database emulators
# (`pnpm dev:infrastructure`). Leave any unset to talk to the real Firebase project.
NUXT_PUBLIC_FIREBASE_EMULATOR_AUTHENTICATION_HOST=http://127.0.0.1:9099
NUXT_PUBLIC_FIREBASE_EMULATOR_STORAGE_HOST=http://127.0.0.1:9199
NUXT_PUBLIC_FIREBASE_EMULATOR_DATABASE_HOST=http://127.0.0.1:9000

# The web app's Firebase config. Against the emulator any non-empty value is
# accepted, and the project id has to keep its `demo-` prefix — that prefix is
# what lets the emulator and firebase-tools run without credentials.
NUXT_PUBLIC_FIREBASE_PROJECT_ID=demo-media-studio
NUXT_PUBLIC_FIREBASE_API_KEY=demo-key
NUXT_PUBLIC_FIREBASE_APP_ID=demo-app
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=127.0.0.1
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-media-studio.firebasestorage.app
NUXT_PUBLIC_FIREBASE_DATABASE_URL=http://127.0.0.1:9000/?ns=demo-media-studio