rules_version = '2';

// Unlike Firestore, Cloud Storage *is* reached from the browser: a cover image
// goes from the picker straight into the bucket, and only the download URL it
// comes back with travels through the API. So these rules are the whole guard
// on that path, not a second line behind one.
//
// The path carries the ownership check — a file lives under the uid that wrote
// it, so nobody can overwrite somebody else's cover by guessing a name.
service firebase.storage {
  match /b/{bucket}/o {
    match /covers/{userId}/{file} {
      allow read: if request.auth != null;

      // Kept in step with COVER_MAX_MB in frontend/app/utils/covers.ts. The
      // client resizes well under this; the cap is here for what skips it.
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      // Separate from the writes above, because a delete carries no
      // `request.resource` to check a size or a type against.
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // What a library item holds: an image, a clip, or the text of one chapter.
    // Same path-as-ownership rule as covers above, and the same reason for it.
    match /content/{userId}/{file} {
      allow read: if request.auth != null;

      // Kept in step with ASSET_MAX_MB in frontend/app/utils/library-content.ts.
      // `text/plain` is here because a chapter body is an object too — the API
      // stores its URL, never its words.
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 200 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*|text/plain.*');

      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
