# Copy to .env (or .env.local, which is read first) and adjust.
# Every variable is optional — the defaults below are what the service uses.
# All of them are validated at boot: a bad value refuses to start the process
# rather than failing on the first request. See src/core/config/env.validation.ts.

# development | test | production
# Production switches logging to single-line JSON.
NODE_ENV=development

# 1-65535. The frontend dev proxy and the e2e suite expect 3001.
PORT=3001

# verbose | debug | log | warn | error | fatal — enables that level and above.
LOG_LEVEL=log

# Serve Swagger UI at /docs and the document at /openapi.json.
# Accepts true/false, 1/0, yes/no, on/off.
API_DOCS_ENABLED=true
