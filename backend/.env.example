# Copy to .env (or .env.local, which is read first) and adjust.
# Every variable is optional — the defaults below are what the service uses.
# Values are read as-is, not validated: an unusable one falls back to its
# default rather than stopping the process. See src/core/config/configuration.ts.

# development | test | production
# Production switches logging to single-line JSON.
NODE_ENV=development

# The frontend expects the API on 3001.
PORT=3001

# verbose | debug | log | warn | error | fatal — enables that level and above.
LOG_LEVEL=log

# Serve Swagger UI at /docs and the document at /openapi.json.
# Set to exactly `false` to turn them off; anything else leaves them on.
API_DOCS_ENABLED=true

# Origins the browser app is served from, comma-separated. The frontend sends the
# ID token in a header, so every API call is preflighted and has to be allowed.
CORS_ORIGINS=http://localhost:3000

# ── Firebase ────────────────────────────────────────────────────────────────
# Accounts and credentials live in Firebase Authentication; this service only
# verifies the ID tokens it is handed, and changes passwords through the Admin
# SDK. Everything the service stores itself lives in Firestore.

# The project the tokens must be issued for. A `demo-` prefix marks an
# emulator-only project, and fails loudly if it ever reaches the real API.
FIREBASE_PROJECT_ID=demo-media-studio

# The project's web API key. Used to check a password before changing it —
# PATCH /auth/me/password proves the current one before setting the new one.
FIREBASE_API_KEY=demo-key

# A service account key as inline JSON, for deployments that cannot use
# application default credentials. Ignored while all three emulator hosts below
# are set — with any service pointing at the real Firebase, a credential is needed.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# The bucket cached answers are written to, under `caches/`. The same bucket the
# browser uploads covers and content to — see the frontend's own .env.example.
FIREBASE_STORAGE_BUCKET=demo-media-studio.firebasestorage.app

# ── Emulators ───────────────────────────────────────────────────────────────
# One host per service, all started by `pnpm dev:infrastructure` from the repo root.
# Leave any out to talk to the real Firebase for that service.
#
# The Admin SDK reads hosts of its own from the environment
# (FIREBASE_AUTH_EMULATOR_HOST, FIRESTORE_EMULATOR_HOST,
# FIREBASE_STORAGE_EMULATOR_HOST) and offers no option for them;
# FirebaseAdminService copies these into those. Set these, not those.

FIREBASE_EMULATOR_AUTHENTICATION_HOST=127.0.0.1:9099

FIREBASE_EMULATOR_FIRESTORE_HOST=127.0.0.1:8080

# Leave this out and cached files go to the real bucket, which without a
# credential fails on the first cache write rather than at startup.
FIREBASE_EMULATOR_STORAGE_HOST=127.0.0.1:9199

# ── Scraping ────────────────────────────────────────────────────────────────
# The FastAPI service in `scraping/`, started by `pnpm dev:infrastructure`. It
# holds one stealth browser, so a call is seconds rather than milliseconds — see
# scraping/README.md.

SCRAPING_BASE_URL=http://127.0.0.1:8000

# How long one call may take. The service's own per-operation default is 120s,
# and a first fetch that has to solve a Cloudflare turnstile can use it.
SCRAPING_TIMEOUT_MS=120000

# How long a scraped answer stays good once cached.
SCRAPING_CACHE_TTL_DAYS=30

# ── Queues ──────────────────────────────────────────────────────────────────
# BullMQ over Redis, started by `pnpm dev:infrastructure`. A manager sends a topic
# through QueueProducer and every consumer listed for it in
# src/core/queues/queue.messages.ts gets a copy on a queue of its own.

REDIS_HOST=127.0.0.1

REDIS_PORT=6379

# Empty for the local Redis, which asks for nothing.
# REDIS_PASSWORD=

# Prefixes every Redis key, so two deployments can share one Redis without
# reading each other's jobs.
QUEUE_PREFIX=media-studio

# How many times a job is tried before it is left in the failed set.
QUEUE_ATTEMPTS=3

# The first retry's delay. Each further one doubles it: 5s, 10s, 20s.
QUEUE_BACKOFF_MS=5000

# How many finished jobs stay in Redis to be looked at afterwards. Failed ones
# are kept longer — they are the ones worth reading.
QUEUE_KEEP_COMPLETED=100

QUEUE_KEEP_FAILED=500
