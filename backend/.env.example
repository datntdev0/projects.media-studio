# Copy to .env (or .env.local, which is read first) and adjust.
# Every variable is optional — the defaults below are what the service uses.
# Values are read as-is, not validated: an unusable one falls back to its
# default rather than stopping the process. See src/core/config/configuration.ts.

# development | test | production
# Production switches logging to single-line JSON.
NODE_ENV=development

# The frontend expects the API on 3001.
PORT=3001

# verbose | debug | log | warn | error | fatal — enables that level and above.
LOG_LEVEL=log

# Serve Swagger UI at /docs and the document at /openapi.json.
# Set to exactly `false` to turn them off; anything else leaves them on.
API_DOCS_ENABLED=true

# Origins the browser app is served from, comma-separated. The frontend sends the
# ID token in a header, so every API call is preflighted and has to be allowed.
CORS_ORIGINS=http://localhost:3000

# ── Firebase Authentication ─────────────────────────────────────────────────
# Accounts and credentials live in Firebase; this service only verifies the ID
# tokens it is handed, and changes passwords through the Admin SDK.

# The project the tokens must be issued for. A `demo-` prefix marks an
# emulator-only project, and fails loudly if it ever reaches the real API.
FIREBASE_PROJECT_ID=demo-media-studio

# The project's web API key. Used to check a password before changing it —
# PATCH /auth/me/password proves the current one before setting the new one.
FIREBASE_API_KEY=demo-key

# `host:port` of the Auth emulator (`pnpm dev:firebase` from the repo root).
# Leave this out to talk to the real Firebase project. Read by the Admin SDK
# itself, which is why it keeps this exact name.
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# A service account key as inline JSON, for deployments that cannot use
# application default credentials. Ignored while the emulator host is set.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
