{
  "name": "media-studio",
  "version": "0.0.0",
  "description": "An automated toolbox for generating rich media content across text, images, audio, and video.",
  "author": "Dat Nguyen",
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:backend": "pnpm --filter @media-studio/backend run dev",
    "dev:frontend": "pnpm --filter @media-studio/frontend run dev",
    "dev:infrastructure": "docker compose -f _deploy/dockercompose.local.infrastructure.yml up --build",
    "seed:firebase": "node scripts/seed-firebase-auth.mjs",
    "generate:api": "pnpm --filter @media-studio/frontend run generate:api",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:cov": "pnpm -r run test:cov",
    "test:e2e": "pnpm --filter @media-studio/tests run test:e2e"
  }
}
